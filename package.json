{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vp build",
        "dev": "vp dev",
        "format": "prettier --write \"**/*.{js,ts,json,yml,md,css}\"",
        "prepare": "husky",
        "outdated": "npm-check-updates"
    },
    "dependencies": {
        "@tailwindcss/vite": "^4.1.11",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.7",
        "vite": "^8.0.0",
        "vite-plus": "0.3.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1",
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1"
    },
    "devDependencies": {
        "husky": "9",
        "lint-staged": "^17.5.1",
        "npm-check-updates": "^23.1.0",
        "prettier": "^3.9.9",
        "prettier-plugin-blade": "^3.3.3",
        "prettier-plugin-tailwindcss": "^0.8.1"
    },
    "name": "@clintonrocha/rock-lab",
    "packageManager": "bun@1.3.14",
    "lint-staged": {
        "*.{js,ts,json,yml,md,css}": [
            "prettier --write"
        ],
        "*.php": [
            "vendor/bin/rector process --memory-limit=2G",
            "vendor/bin/pint"
        ]
    }
}
